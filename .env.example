# Copy to .env. Leave LLM_API_KEY empty to use the built-in deterministic demo agent.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=your-openai-compatible-model

# Change this before exposing the admin approval endpoint to the internet.
ADMIN_TOKEN=dev-admin-change-me

# Persistent SQLite files are stored here.
DATA_DIR=./data
