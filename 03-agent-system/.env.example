# 复制本文件为 .env 并填写真实值。敏感项绝不落库、不写日志、不传前端。

# LLM 模型名（留空则使用离线 Mock，无需 Key 即可演示/测试）
LLM_MODEL=

# OpenAI 兼容接口的 API Key 与 Base URL
LLM_API_KEY=
LLM_BASE_URL=

# 接口格式：anthropic | openai。留空则按 Base URL 自动识别
# （火山方舟 coding 端点 /api/coding、智谱 /api/anthropic 等为 anthropic 格式）
LLM_API_FORMAT=

# 向量后端：chroma（默认，需安装 chromadb）或 simple（内置，零依赖，自动兜底）
RETRIEVAL_VECTOR_BACKEND=chroma

# 知识库存储路径（相对项目根目录；默认 data/ 下，均本地持久化）
# RETRIEVAL_FTS_DB=data/fts.db
# RETRIEVAL_DOCS_DB=data/docs.db
# RETRIEVAL_CHROMA_PATH=data/chroma

# 商品目录库（首次启动自动写入内置种子；产品文档入库时自动登记商品）
# PRODUCTS_DB=data/products.db

# Embedding 后端：local | api | hash（留空 = 自动：下方 EMBEDDING_* 三项填齐则用 api，否则 hash）
# local = 本地 ONNX 模型 bge-small-zh-v1.5（fastembed，512 维，首次运行自动下载约 100MB 到 data/models/，
#         下载/加载失败自动回退特征哈希，系统始终可用）
EMBEDDING_BACKEND=

# 国内网络下载本地模型建议启用 HuggingFace 镜像（首次下载 data/models/ 缓存后可去掉）
# 镜像不支持 Xet 协议，需一并禁用，否则下载报 401
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1

# 向量 embedding（API 模式：OpenAI 兼容的 embedding 模型名，复用下方 LLM 的 Key/Base URL 或单设 EMBEDDING_*）
EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=